{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.g2.galactictycoons.com/:path*"
    },
    {
      "source": "/db/:path*",
      "destination": "https://REPLACE_WITH_RAILWAY_URL/db/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=30, stale-while-revalidate=60" }
      ]
    }
  ]
}
